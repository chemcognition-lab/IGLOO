#!/bin/bash
# Option-B rebuild orchestrator. Runs on a compute node (login node is flaky).
# Submits every training job, then every attribution/diagnostic job with an
# afterok dependency on the model it needs. Assumes the float32 by_seq cache has
# been warmed (rebuild_warm_cache.sh).
#
#SBATCH --account=aip-bensl
#SBATCH --job-name=rebuild_orch
#SBATCH --output=jobs/logs/rebuild_orch_%j.out
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=0:30:00

cd /project/aip-bensl/ranaab/IGLOO || exit 1

PROTS=(GB1 T4Lysozyme)
LAND=(additive epistatic nonlinear)
NOISE=(0.0 0.05 0.1 0.3 0.5 0.8 1.0)
SEEDS=(1 2 3 4 5)
EMAIL=ranamoneim@gmail.com
mkdir -p jobs/logs

res() {  # protein -> "MEM TIME_train TIME_attr"
  if [[ "$1" == GB1 ]]; then echo "128G 3:00:00 2:00:00"; else echo "256G 8:00:00 4:00:00"; fi
}
sb() { sbatch --parsable --account=aip-bensl --gres=gpu:l40s:1 --cpus-per-task=4 \
              --mail-type=FAIL --mail-user="$EMAIL" "$@"; }

declare -A NS SS SH PM   # job-id maps

echo "===== WAVE A: training ====="
for P in "${PROTS[@]}"; do read MEM TT TA < <(res "$P")
  for D in "${LAND[@]}"; do
    for N in "${NOISE[@]}"; do
      NS["$P|$D|$N"]=$(sb --job-name="ns_${P}_${D}_n${N}" --output="jobs/logs/ns_${P}_${D}_n${N}_%j.out" \
        --mem=$MEM --time=$TT --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N" jobs/synthetic/run_noise_sweep_job.sh)
      for S in "${SEEDS[@]}"; do
        SS["$P|$D|$N|$S"]=$(sb --job-name="ss_${P}_${D}_n${N}_s${S}" --output="jobs/logs/ss_${P}_${D}_n${N}_s${S}_%j.out" \
          --mem=$MEM --time=$TT --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N,SEED=$S" jobs/synthetic/run_seedsweep_job.sh)
      done
    done
    for S in "${SEEDS[@]}"; do
      SH["$P|$D|$S"]=$(sb --job-name="sh_${P}_${D}_s${S}" --output="jobs/logs/sh_${P}_${D}_s${S}_%j.out" \
        --mem=$MEM --time=$TT --export="PROTEIN=$P,DATA_MODEL=$D,SEED=$S" jobs/synthetic/run_shuffle_job.sh)
    done
    for N in 0.0 1.0; do for S in 1 2 3; do
      PM["$P|$D|$N|$S"]=$(sb --job-name="pm_${P}_${D}_n${N}_s${S}" --output="jobs/logs/pm_${P}_${D}_n${N}_s${S}_%j.out" \
        --mem=$MEM --time=$TT --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N,SEED=$S" jobs/architectures/run_premlp_job.sh)
    done; done
  done
done
echo "wave A submitted: ${#NS[@]} noise + ${#SS[@]} seed + ${#SH[@]} shuffled + ${#PM[@]} premlp"

echo "===== WAVE B: attributions / diagnostics (afterok on their model) ====="
for P in "${PROTS[@]}"; do read MEM TT TA < <(res "$P")
  for D in "${LAND[@]}"; do
    for N in "${NOISE[@]}"; do
      dep=${NS["$P|$D|$N"]}
      for M in signed gradient displacement grad_input; do
        sb --dependency=afterok:$dep --job-name="fa_${P}_${D}_n${N}_${M}" \
           --output="jobs/logs/fa_${P}_${D}_n${N}_${M}_%j.out" --mem=$MEM --time=$TA \
           --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N,METHOD=$M" jobs/attribution/run_factor_ablation_job.sh >/dev/null
      done
      sb --dependency=afterok:$dep --job-name="ism_${P}_${D}_n${N}" \
         --output="jobs/logs/ism_${P}_${D}_n${N}_%j.out" --mem=$MEM --time=$TA \
         --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N" jobs/attribution/run_ism_job.sh >/dev/null
      if [[ "$N" == 0.0 || "$N" == 0.5 || "$N" == 1.0 ]]; then
        sb --dependency=afterok:$dep --job-name="mech_${P}_${D}_n${N}" \
           --output="jobs/logs/mech_${P}_${D}_n${N}_%j.out" --mem=$MEM --time=$TA \
           --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N" jobs/attribution/run_mechanism_job.sh >/dev/null
      fi
      if [[ "$N" == 0.0 || "$N" == 0.3 || "$N" == 0.5 || "$N" == 1.0 ]]; then
        sb --dependency=afterok:$dep --job-name="casc_${P}_${D}_n${N}" \
           --output="jobs/logs/casc_${P}_${D}_n${N}_%j.out" --mem=$MEM --time=$TA \
           --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N" jobs/attribution/run_cascading_job.sh >/dev/null
      fi
      # multi-seed ISM at a subset of noise levels
      if [[ "$N" == 0.0 || "$N" == 0.3 || "$N" == 1.0 ]]; then
        for S in "${SEEDS[@]}"; do
          sb --dependency=afterok:${SS["$P|$D|$N|$S"]} --job-name="ismS_${P}_${D}_n${N}_s${S}" \
             --output="jobs/logs/ismS_${P}_${D}_n${N}_s${S}_%j.out" --mem=$MEM --time=$TA \
             --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N,SEED=$S" jobs/attribution/run_ism_job.sh >/dev/null
        done
      fi
    done
    for S in "${SEEDS[@]}"; do
      sb --dependency=afterok:${SH["$P|$D|$S"]} --job-name="ismX_${P}_${D}_s${S}" \
         --output="jobs/logs/ismX_${P}_${D}_s${S}_%j.out" --mem=$MEM --time=$TA \
         --export="PROTEIN=$P,DATA_MODEL=$D,SEED=$S" jobs/attribution/run_ism_shuffled_job.sh >/dev/null
    done
    for N in 0.0 1.0; do for DG in mech casc; do
      sb --dependency=afterok:${PM["$P|$D|$N|1"]} --job-name="${DG}P_${P}_${D}_n${N}" \
         --output="jobs/logs/${DG}P_${P}_${D}_n${N}_%j.out" --mem=$MEM --time=$TA \
         --export="PROTEIN=$P,DATA_MODEL=$D,NOISE=$N,SEED=1,DIAG=$DG" jobs/attribution/run_premlp_diag_job.sh >/dev/null
    done; done
  done
done
echo "wave B submitted."
squeue -u ranaab -h | wc -l
