# IGLOO Environment Configuration Template
# Copy this file to .env and customize the values for your setup

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Project paths
IGLOO_ROOT=/path/to/igloo
IGLOO_DATA_DIR=${IGLOO_ROOT}/data
IGLOO_RESULTS_DIR=${IGLOO_ROOT}/results
IGLOO_LOGS_DIR=${IGLOO_ROOT}/logs

# Python environment
PYTHONPATH=${IGLOO_ROOT}/src
PYTHON_VERSION=3.10

# =============================================================================
# MODEL SETTINGS
# =============================================================================

# ESM Model Configuration
ESM_MODEL_NAME=esm2_t33_650M_UR50D
ESM_CACHE_DIR=${IGLOO_ROOT}/.cache/esm

# Hugging Face Models Cache
TRANSFORMERS_CACHE=${IGLOO_ROOT}/.cache/transformers
HF_HOME=${IGLOO_ROOT}/.cache/huggingface

# =============================================================================
# COMPUTE SETTINGS
# =============================================================================

# CUDA Settings
CUDA_VISIBLE_DEVICES=0,1,2,3
TORCH_CUDA_ARCH_LIST="6.0 6.1 7.0 7.5 8.0 8.6 9.0"

# CPU Settings
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
NUMEXPR_NUM_THREADS=8

# Memory Management
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
TOKENIZERS_PARALLELISM=false

# =============================================================================
# ANALYSIS SETTINGS
# =============================================================================

# Default analysis parameters
DEFAULT_BATCH_SIZE=32
DEFAULT_N_STEPS=100
DEFAULT_INTERNAL_BATCH_SIZE=8

# Visualization settings
MATPLOTLIB_BACKEND=Agg
PLOTLY_RENDERER=png

# 3D Visualization
PYMOL_PATH=/usr/bin/pymol
PY3DMOL_TIMEOUT=30

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development mode
IGLOO_DEV_MODE=false
IGLOO_DEBUG=false
IGLOO_VERBOSE=false

# Testing
PYTEST_WORKERS=auto
PYTEST_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# JUPYTER SETTINGS
# =============================================================================

# Jupyter configuration
JUPYTER_PORT=8888
JUPYTER_IP=0.0.0.0
JUPYTER_TOKEN=
JUPYTER_PASSWORD=

# =============================================================================
# DATABASE SETTINGS (Optional)
# =============================================================================

# PostgreSQL (for storing results)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=igloo
POSTGRES_USER=igloo
POSTGRES_PASSWORD=change_me_in_production

# Redis (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# CLOUD SETTINGS (Optional)
# =============================================================================

# AWS Settings
AWS_REGION=us-west-2
AWS_S3_BUCKET=igloo-data
AWS_PROFILE=default

# Google Cloud Settings
GOOGLE_CLOUD_PROJECT=igloo-project
GOOGLE_APPLICATION_CREDENTIALS=${IGLOO_ROOT}/credentials/gcp-key.json

# Azure Settings
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=igloo-rg
AZURE_STORAGE_ACCOUNT=igloodata

# =============================================================================
# MONITORING AND LOGGING (Optional)
# =============================================================================

# Weights & Biases
WANDB_PROJECT=igloo
WANDB_ENTITY=your-username
WANDB_API_KEY=your-api-key

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=igloo-experiments

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# API Keys (keep these secure!)
HUGGINGFACE_TOKEN=your-hf-token
OPENAI_API_KEY=your-openai-key

# SSL/TLS
SSL_VERIFY=true
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
