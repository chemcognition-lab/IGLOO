.PHONY: clean clean-build clean-pyc clean-test coverage dist docs help install lint test setup setup-dev docker-build docker-run

.DEFAULT_GOAL := help

define BROWSER_PYSCRIPT
import os, webbrowser, sys

from urllib.request import pathname2url

webbrowser.open("file://" + pathname2url(os.path.abspath(sys.argv[1])))
endef
export BROWSER_PYSCRIPT

define PRINT_HELP_PYSCRIPT
import re, sys

for line in sys.stdin:
	match = re.match(r'^([a-zA-Z_-]+):.*?## (.*)$$', line)
	if match:
		target, help = match.groups()
		print("%-20s %s" % (target, help))
endef
export PRINT_HELP_PYSCRIPT

BROWSER := python -c "$$BROWSER_PYSCRIPT"

help:
	@python -c "$$PRINT_HELP_PYSCRIPT" < $(MAKEFILE_LIST)

clean: clean-build clean-pyc clean-test ## remove all build, test, coverage and Python artifacts

clean-build: ## remove build artifacts
	rm -fr build/
	rm -fr dist/
	rm -fr .eggs/
	find . -name '*.egg-info' -exec rm -fr {} +
	find . -name '*.egg' -exec rm -f {} +

clean-pyc: ## remove Python file artifacts
	find . -name '*.pyc' -exec rm -f {} +
	find . -name '*.pyo' -exec rm -f {} +
	find . -name '*~' -exec rm -f {} +
	find . -name '__pycache__' -exec rm -fr {} +

clean-test: ## remove test and coverage artifacts
	rm -fr .tox/
	rm -f .coverage
	rm -fr htmlcov/
	rm -fr .pytest_cache

## Environment Setup
setup: ## set up the environment automatically
	chmod +x setup_environment.sh
	./setup_environment.sh

setup-dev: ## set up development environment
	chmod +x setup_environment.sh
	./setup_environment.sh --dev

setup-conda: ## set up environment using conda
	conda env create -f environment.yml

setup-conda-cpu: ## set up CPU-only environment using conda
	conda env create -f environment-cpu.yml

setup-pip: ## set up environment using pip
	python3 -m venv venv_igloo
	. venv_igloo/bin/activate && pip install -r requirements.txt && pip install -e .

setup-pip-cpu: ## set up CPU-only environment using pip
	python3 -m venv venv_igloo
	. venv_igloo/bin/activate && pip install -r requirements-cpu.txt && pip install -e .

## Code Quality
lint: ## check style with ruff and mypy
	ruff check src/ tests/ scripts/
	mypy src/ --ignore-missing-imports

format: ## format code with black and ruff
	black src/ tests/ scripts/
	ruff format src/ tests/ scripts/
	isort src/ tests/ scripts/

## Testing
test: ## run tests quickly with pytest
	pytest tests/ -v

test-cov: ## run tests with coverage
	pytest tests/ -v --cov=src/igloo --cov-report=html --cov-report=term

test-all: ## run tests on every Python version with tox
	tox

## Analysis Scripts
run-demo: ## run demo analysis
	python scripts/demo_analysis_methods.py

run-pafa: ## run PafA analysis
	python scripts/PafA_linear_IG.py

run-betalactamase: ## run betalactamase analysis
	python scripts/betalactamase_linear_IG.py

run-all: ## run all integrated gradients analyses
	python scripts/run_all_ig_analyses.py

run-3d-demo: ## run 3D structure visualization demo
	python scripts/demo_3d_structure_visualization.py

## Documentation
docs: ## generate Sphinx HTML documentation, including API docs
	rm -f docs/igloo.rst
	rm -f docs/modules.rst
	sphinx-apidoc -o docs/ src/igloo
	$(MAKE) -C docs clean
	$(MAKE) -C docs html
	$(BROWSER) docs/_build/html/index.html

servedocs: docs ## compile the docs watching for changes
	watchmedo shell-command -p '*.rst' -c '$(MAKE) -C docs html' -R -D .

## Docker
docker-build: ## build Docker image
	docker-compose build igloo-dev

docker-run: ## run development environment in Docker
	docker-compose up igloo-dev

docker-test: ## run tests in Docker
	docker-compose --profile testing run igloo-test

docker-prod: ## run production environment in Docker
	docker-compose --profile production up igloo-prod

## Package Management
coverage: ## check code coverage quickly with pytest
	pytest tests/ --cov=src/igloo --cov-report=html --cov-report=term
	$(BROWSER) htmlcov/index.html

release: dist ## package and upload a release
	twine upload dist/*

dist: clean ## builds source and wheel package
	python -m build
	ls -l dist

install: clean ## install the package to the active Python's site-packages
	pip install -e .
